<!doctype html>
<html>
    <head>
        <title><%=shopData.shopName%> Users</title>
        <link rel="stylesheet"  type="text/css" href="/main.css" />
    </head>
    <body>
        <h1><%=shopData.shopName%> Registered Users</h1>
        <h2>User Details (passwords excluded)</h2>
        <table>
            <tr>
                <th>Username</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
            </tr>
            <% if (availableUsers && availableUsers.length) { %>
                <% availableUsers.forEach(function(user){ %>
                    <tr>
                        <td><%= user.username %></td>
                        <td><%= user.first_name %></td>
                        <td><%= user.last_name %></td>
                        <td><%= user.email %></td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr><td colspan="4">No registered users found.</td></tr>
            <% } %>
        </table>
        <p><a href="/">Back to Home</a></p>
    </body>
</html>